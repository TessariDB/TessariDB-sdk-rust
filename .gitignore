# Rust
/target
# Clippy gets its own, because check, clippy and test are three compile modes
# and sharing one directory makes them evict each other's fingerprints — the
# cost is a full rebuild on every alternation, not a slower one.
/target-lint
**/*.rs.bk
*.pdb

# Data / runtime
/data
*.db
*.log

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Local agent-tooling state, never published
.bgv
.bgv/
.githooks/
CLAUDE.md
AGENTS.md
MEMORY.md
